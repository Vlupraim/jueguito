[sub_resource type="Shader" id="Shader_earth"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;

void fragment() {
	vec2 centered = (UV - vec2(0.5)) * vec2(1.0, 1.65);
	float contact = 1.0 - smoothstep(0.08, 0.52, length(centered));
	ALBEDO = vec3(0.018, 0.012, 0.008);
	ALPHA = contact * 0.34;
}
"

